# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env / server secrets (never commit)
.env
.env.*
!.env.example
supabase.env
*.env
!supabase/secrets.example

# Firebase / FCM (project-specific — never commit the real file)
google-services.json
!google-services.json.example
.temp/
*-firebase-adminsdk-*.json
**/firebase-adminsdk*.json

# Local crash / debug dumps
crash.txt
null

# Supabase CLI temp / linked project metadata
supabase/.temp/

# Accidental Metro dumps
bundle.js

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
