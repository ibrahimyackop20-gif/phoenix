# Client-safe Expo public variables only.
# Copy to `.env` for local development. Never put server secrets here.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_CENTRAL_SUPABASE_URL=
EXPO_PUBLIC_CENTRAL_SUPABASE_ANON_KEY=

# Optional — used by SSO / profile sync bridge
# EXPO_PUBLIC_WEB_URL=

# -----------------------------------------------------------------------------
# EAS production builds (required)
# -----------------------------------------------------------------------------
# Set all four variables above in the Expo dashboard for the "production"
# environment before running:
#   eas build --platform android --profile production
#
# Expo dashboard: Project → Environment variables → production
#
# Or via CLI (replace placeholders; do not commit real values):
#   eas env:create --environment production --name EXPO_PUBLIC_SUPABASE_URL --value "<url>"
#   eas env:create --environment production --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value "<key>"
#   eas env:create --environment production --name EXPO_PUBLIC_CENTRAL_SUPABASE_URL --value "<url>"
#   eas env:create --environment production --name EXPO_PUBLIC_CENTRAL_SUPABASE_ANON_KEY --value "<key>"
#
# Do NOT add these values to eas.json or commit them to git.
