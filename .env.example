# Client-safe Expo public variables only.
# Copy to `.env` for local development. Never put server secrets here.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_CENTRAL_SUPABASE_URL=
EXPO_PUBLIC_CENTRAL_SUPABASE_ANON_KEY=

# Optional — used by SSO / profile sync bridge
# EXPO_PUBLIC_WEB_URL=

# -----------------------------------------------------------------------------
# EAS builds (REQUIRED — missing values cause a broken release APK)
# -----------------------------------------------------------------------------
# These four variables are inlined into the JS bundle at build time.
# If they are absent from the EAS environment linked by eas.json
# (`preview` / `production`), the standalone APK will start without Supabase
# credentials (the app no longer hard-crashes, but auth/data will not work).
#
# Expo dashboard: Project → Environment variables
# Create them for environments: preview AND production
#
#   EXPO_PUBLIC_SUPABASE_URL
#   EXPO_PUBLIC_SUPABASE_ANON_KEY
#   EXPO_PUBLIC_CENTRAL_SUPABASE_URL
#   EXPO_PUBLIC_CENTRAL_SUPABASE_ANON_KEY
#
# CLI examples (do not commit real values):
#   eas env:create --environment production --name EXPO_PUBLIC_SUPABASE_URL --value "<url>" --visibility plaintext
#   eas env:create --environment production --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value "<key>" --visibility plaintext
#   eas env:create --environment production --name EXPO_PUBLIC_CENTRAL_SUPABASE_URL --value "<url>" --visibility plaintext
#   eas env:create --environment production --name EXPO_PUBLIC_CENTRAL_SUPABASE_ANON_KEY --value "<key>" --visibility plaintext
#
# Repeat for --environment preview.
#
# Do NOT add these values to eas.json or commit them to git.
